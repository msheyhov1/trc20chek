# Эти переменные нужно задать в Railway → Variables (НЕ заливать в git)

# --- Обязательно ---
BOT_TOKEN=
# Доступ к боту — ТОЛЬКО по Telegram ID: список разрешённых user_id через запятую.
# Пусто = бот закрыт для ВСЕХ (fail-closed), каждая проверка тратит платные лимиты KYT.
# Только цифры, без кавычек и без @username (кавычки ломают разбор — id отбрасываются).
# Свой ID: напишите боту — он вернёт его в отказе, либо спросите у @userinfobot.
ALLOWED_TG_IDS=
# Кто может ставить и снимать ручные метки (/label, /unlabel). Метка меняет
# вердикт для всех пользователей — и для адресов, пересылающих на размеченный.
# Пусто — любой из ALLOWED_TG_IDS (как раньше).
ADMIN_TG_IDS=

# --- Опционально (повышают лимиты, бесплатные) ---
TRONSCAN_API_KEY=
GOPLUS_API_KEY=

# --- Опциональная защита публичного API ---
# Если задано — внешние запросы должны слать ?api_key=...
API_KEY=

# --- Пароль на веб-сайт (HTTP Basic Auth) ---
# Если задан WEB_PASSWORD — сайт (/ и /check) спросит логин/пароль.
# Пусто = сайт открыт. Логин по умолчанию admin, можно сменить через WEB_USER.
WEB_USER=admin
WEB_PASSWORD=

# --- Внешний AML: Swapster (туннель) ---
# Запрашивается ТОЛЬКО для НЕ-биржевых кошельков (биржи/депозитники/контракты
# AML не проверяются). Пусто → в выводе «Swapster не настроен».
SWAPSTER_API_TOKEN=
# Боевой: https://api.swapster.fi · тест: https://test-api.swapster.fi
SWAPSTER_API_BASE_URL=https://api.swapster.fi
# Опц. прокси со статичным IP под whitelist Swapster (http://user:pass@host:port или socks5://host:port)
SWAPSTER_PROXY_URL=
SWAPSTER_PAY_CURRENCY=USDT
SWAPSTER_CHECK_CURRENCY=USDT
SWAPSTER_CHECK_NETWORK=TRC20
SWAPSTER_TIMEOUT_SECONDS=30
# Порог: если у неразмеченного адреса доминирующая биржевая сущность Swapster
# (EXCHANGE*) занимает ≥ этой доли — помечаем адрес как биржу/сервис.
# Ниже порог → ловим больше бирж, но выше риск принять «тяжёлого» юзера биржи
# за саму биржу. 0.9 = 90%.
AML_EXCHANGE_ENTITY_THRESHOLD=0.9

# --- Внешний AML: Bitok KYT (второй сервис, рядом со Swapster) ---
# Ключи создаются в кабинете Bitok (kyt.bitok2.org) → API Keys. Secret показывается
# один раз при создании. Пусто → в выводе «Bitok не настроен».
BITOK_API_KEY_ID=
BITOK_API_SECRET=
# Контур РФ (тот же, что и вход kyt.bitok2.org)
BITOK_API_BASE_URL=https://kyt-api.bitok2.org
BITOK_NETWORK=TRX
# Настенный бюджет всей проверки Bitok (asyncio.timeout вокруг всего флоу).
# Раньше он проверялся только между запросами и превышался на десятки секунд.
BITOK_TIMEOUT_SECONDS=45
# Сколько секунд переиспользовать готовый ответ Swapster/Bitok по адресу, чтобы
# «Перепроверить» не оплачивало оба сервиса заново. On-chain часть проверки
# всегда свежая. 0 — кеш выключен.
KYT_CACHE_SECONDS=3600

# Внешние AML (Swapster/Bitok) поднимают итоговый вердикт при caution/dangerous.
# 0 — показывать их результат, но вердикт не менять.
EXTERNAL_AML_AFFECTS_RISK=1

# --- Блокировка USDT эмитентом (блэклист Tether) ---
# Самый жёсткий сигнал для USDT-TRC20: заблокированные средства неподвижны.
# Читается прямо у контракта USDT (isBlackListed) через TronGrid, запасной
# путь — /api/security/account/data у TronScan. Ключи не обязательны.
TRONGRID_API_URL=https://api.trongrid.io
# Опционален: free-тариф ~100k запросов/сутки и 15 QPS, без ключа заметно жёстче
TRONGRID_API_KEY=
# 0 — не проверять блэклист вовсе
TETHER_BLACKLIST_CHECK=1
# Контракт USDT-TRC20 для проверки блэклиста и баланса. Менять незачем —
# только для тестовой сети.
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# --- Доступ к вебу и лимиты ---
# Без WEB_PASSWORD и без API_KEY эндпоинт /check отвечает 503: каждая проверка
# тратит платные лимиты KYT, поэтому «открыт всем» — только по явному согласию.
WEB_PUBLIC=0
# Лимиты для открытого доступа (0 = без ограничения)
RATE_LIMIT_PER_IP=20
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_DAILY=500
# Сколько прокси перед приложением дописывают адрес в X-Forwarded-For.
# У Railway — один край. Лимит на IP берёт адрес, который дописал он, а не
# начало заголовка: его присылает сам клиент и может подставить что угодно.
# Если все пользователи упираются в один и тот же лимит — значит, прокси два:
# поставьте 2. Без прокси (прямой доступ) — 0.
TRUSTED_PROXY_HOPS=1
# CORS: список origin через запятую. Пусто = CORS выключен (веб-форма ходит на
# свой же origin относительным URL и в нём не нуждается).
CORS_ORIGINS=

# --- Объёмная математика AML ---
# В расчёт долей экспозиции идут только эти контракты (USDT/USDC/USDD/TUSD/USDJ
# зашиты). Сверяется КОНТРАКТ, а не символ: символ «USDT» подделывается
# тривиально, и один такой перевод разбавлял санкционную экспозицию до нуля.
# Формат: адрес:символ через запятую.
AML_VOLUME_TOKENS=
# Сколько страниц переводов добирать для ПРОВЕРЯЕМОГО адреса (по 50 на
# страницу, TronScan max 50/запрос). Окно в 50 переводов у активного адреса
# легко оказывается целиком входящим или целиком исходящим, и funnel-эвристика
# не видит второй половины паттерна — депозитник биржи выглядит личным
# кошельком. Вторая страница стоит один запрос.
FLOW_PAGES=2
# Глубина для посредников 2-го хопа — отдельно: их до двенадцати, и лишняя
# страница на каждого это уже двенадцать запросов.
AML_HOP2_FLOW_PAGES=1

# --- Пороги эвристик (тюнятся на реальных данных, без пересборки образа) ---
# Депозитник биржи: концентрация оттока на одну биржу, доля пересылаемого,
# допустимый обратный поток с этой же биржи (газ, а не торговля).
DEPOSIT_CONCENTRATION=0.9
DEPOSIT_FORWARD_RATIO=0.5
DEPOSIT_BACKFLOW_RATIO=0.15
# Одноразовый депозитник (Binance/Bybit выдают адрес под один депозит): ОДИН
# приход и свип почти всей суммы на биржу. Свидетельств меньше, поэтому пороги
# жёстче, а вывод помечается как вероятный и не получает поддавков известного
# сервиса — платные KYT для него запрашиваются.
DEPOSIT_SWEEP_CONCENTRATION=0.99
DEPOSIT_SWEEP_FORWARD_RATIO=0.9
# Транзит: форвардит ≥ этой доли полученного и не копит баланс
TRANSIT_FORWARD_RATIO=0.8
# Вес косвенной (2-хоп) экспозиции относительно прямой
# 2-й хоп: раскрыть неизвестных посредников и посмотреть ИХ санкционную
# экспозицию. 0 — выключить. LIMIT — сколько посредников, CONCURRENCY —
# сколько запросов к TronScan параллельно (выше — быстрее, но ближе к 429).
AML_HOP2=1
AML_HOP2_LIMIT=12
AML_HOP2_CONCURRENCY=4
AML_HOP2_WEIGHT=0.6
# Активность, выше которой нетегированный адрес считаем возможным сервисом
UNTAGGED_SERVICE_TX=50000

# --- Отравление истории (адрес-двойник) ---
# Сколько символов по краям должно совпасть и какая сумма считается пылью
POISON_PREFIX_CHARS=4
POISON_SUFFIX_CHARS=4
POISON_DUST_MAX=1.0

# --- Высокорисковые обменники по тегу TronScan ---
# Обменники без KYC и P2P НЕ должны попадать в EXCHANGE: тот трактуется как
# безопасный и отключает платные KYT. Список пуст намеренно — состав надо
# брать из проверяемого источника. Формат: подстрока_тега:Имя через запятую.
HIGH_RISK_EXCHANGES=

# --- Сервисы, которые TronScan не размечает (по АДРЕСУ) ---
# CryptoBot, Telegram Wallet и другие кастодиальные сервисы публичного тега
# могут не иметь. Адрес из этого списка опознаётся и как сам проверяемый
# адрес, и как контрагент в переводах — второе важнее: без него
# funnel-эвристика не видит сервис в оттоке и его депозитники остаются
# «личными кошельками». Достаточно одного хот-кошелька.
# То же самое — из бота командой /label АДРЕС exchange safe Имя.
# Формат: адрес:Имя через запятую. Адрес проверяется base58check.
SERVICE_ADDRESSES=

# --- Санкционный список OFAC ---
# Фид разложен ПО АКТИВАМ, а не по сетям: TRON-адреса лежат и в файле USDT.
# Чтение одного TRX давало 254 адреса вместо 334.
# Коды активов через запятую; каждая строка фильтруется по формату TRON.
OFAC_ASSETS=TRX,USDT,USDC,XBT

# --- Профиль адреса и собственные оценки TronScan ---
# Моложе скольких дней адрес считается свежим (флаг, не риск сам по себе)
NEW_ADDRESS_DAYS=30
# Нижняя граница риска при жалобах пользователей (feedbackRisk). Для опознанной
# биржи не применяется: на них жалуются постоянно.
FEEDBACK_RISK_SCORE=30
# Серая метка TronScan на самом адресе задаёт скор (было «ОСТОРОЖНО · 0/100»)
GREY_TAG_SCORE=30
# Вес доли объёма через переводы и контрагентов, рискованных по оценке самого
# TronScan (riskTransaction, normalAddressInfo.risk). Ниже веса санкций.
TRONSCAN_RISK_WEIGHT=0.5

# --- Безопасность контрактов ---
# GET /api/security/token/data у TronScan. 0 — не проверять.
TOKEN_SECURITY_CHECK=1

# --- Журнал проверок и ручные метки (на том же volume /data) ---
# Журнал даёт сравнение с прошлым результатом («было 20, стало 80»), историю
# в боте и вебе и видимый расход платных лимитов KYT.
HISTORY_ENABLED=1
HISTORY_PATH=/data/history.db
# Кеш вердиктов и накопительный кластер депозитников — на том же томе.
# В образе уже заданы в Dockerfile; меняйте, только если том смонтирован не в /data.
CACHE_PATH=/data/cache.db
CLUSTER_PATH=/data/cluster.db
HISTORY_RETENTION_DAYS=180
HISTORY_MAX_ROWS=50000
# Метки адресов правятся командами бота (/label, /unlabel) без редеплоя.
# Предзаданные в core/providers/local.py засеваются сюда при старте.
LABELS_PATH=/data/labels.db

# --- Мониторинг адресов (/watch в боте) ---
# Фоновая перепроверка наблюдаемых адресов и уведомление при СМЕНЕ уровня риска.
# Каждая перепроверка платная, поэтому частота ограничена на адрес и на тик.
WATCHLIST_ENABLED=1
WATCHLIST_PATH=/data/watchlist.db
WATCHLIST_INTERVAL_SECONDS=43200
WATCHLIST_TICK_SECONDS=300
WATCHLIST_BATCH_PER_TICK=3
WATCHLIST_MAX_PER_USER=20
# Неполная проверка (источник не ответил) не считается сменой уровня; повтор —
# через столько секунд, а не на каждом тике.
WATCHLIST_RETRY_SECONDS=3600

# --- Пакетная проверка и бюджет времени ---
# Общий дедлайн одной проверки: по истечении отдаётся частичный результат с
# пометкой, вместо бесконечного ожидания. 0 — без ограничения.
CHECK_BUDGET_SECONDS=90
# Сколько адресов принимает POST /check/batch
BATCH_MAX_ADDRESSES=25
# Сколько адресов проверяем из одного сообщения и из присланного файла
MAX_ADDRESSES_PER_MESSAGE=5
MAX_ADDRESSES_PER_FILE=25
BATCH_FILE_MAX_BYTES=262144

# --- Кеш ---
CACHE_TTL_SECONDS=604800
# CACHE_PATH задаётся автоматически на /data/cache.db
