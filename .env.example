# Эти переменные нужно задать в Railway → Variables (НЕ заливать в git)

# --- Обязательно ---
BOT_TOKEN=
# Доступ к боту — ТОЛЬКО по Telegram ID: список разрешённых user_id через запятую.
# Пусто = бот закрыт для ВСЕХ (fail-closed), каждая проверка тратит платные лимиты KYT.
# Только цифры, без кавычек и без @username (кавычки ломают разбор — id отбрасываются).
# Свой ID: напишите боту — он вернёт его в отказе, либо спросите у @userinfobot.
ALLOWED_TG_IDS=

# --- Опционально (повышают лимиты, бесплатные) ---
TRONSCAN_API_KEY=
GOPLUS_API_KEY=

# --- Опциональная защита публичного API ---
# Если задано — внешние запросы должны слать ?api_key=...
API_KEY=

# --- Пароль на веб-сайт (HTTP Basic Auth) ---
# Если задан WEB_PASSWORD — сайт (/ и /check) спросит логин/пароль.
# Пусто = сайт открыт. Логин по умолчанию admin, можно сменить через WEB_USER.
WEB_USER=admin
WEB_PASSWORD=

# --- Внешний AML: Swapster (туннель) ---
# Запрашивается ТОЛЬКО для НЕ-биржевых кошельков (биржи/депозитники/контракты
# AML не проверяются). Пусто → в выводе «Swapster не настроен».
SWAPSTER_API_TOKEN=
# Боевой: https://api.swapster.fi · тест: https://test-api.swapster.fi
SWAPSTER_API_BASE_URL=https://api.swapster.fi
# Опц. прокси со статичным IP под whitelist Swapster (http://user:pass@host:port или socks5://host:port)
SWAPSTER_PROXY_URL=
SWAPSTER_PAY_CURRENCY=USDT
SWAPSTER_CHECK_CURRENCY=USDT
SWAPSTER_CHECK_NETWORK=TRC20
SWAPSTER_TIMEOUT_SECONDS=30
# Порог: если у неразмеченного адреса доминирующая биржевая сущность Swapster
# (EXCHANGE*) занимает ≥ этой доли — помечаем адрес как биржу/сервис.
# Ниже порог → ловим больше бирж, но выше риск принять «тяжёлого» юзера биржи
# за саму биржу. 0.9 = 90%.
AML_EXCHANGE_ENTITY_THRESHOLD=0.9

# --- Внешний AML: Bitok KYT (второй сервис, рядом со Swapster) ---
# Ключи создаются в кабинете Bitok (kyt.bitok2.org) → API Keys. Secret показывается
# один раз при создании. Пусто → в выводе «Bitok не настроен».
BITOK_API_KEY_ID=
BITOK_API_SECRET=
# Контур РФ (тот же, что и вход kyt.bitok2.org)
BITOK_API_BASE_URL=https://kyt-api.bitok2.org
BITOK_NETWORK=TRX
# Общий таймаут проверки, он же бюджет поллинга результата
BITOK_TIMEOUT_SECONDS=45

# Внешние AML (Swapster/Bitok) поднимают итоговый вердикт при caution/dangerous.
# 0 — показывать их результат, но вердикт не менять.
EXTERNAL_AML_AFFECTS_RISK=1

# --- Кеш ---
CACHE_TTL_SECONDS=604800
# CACHE_PATH задаётся автоматически на /data/cache.db
