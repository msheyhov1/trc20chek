# Эти переменные нужно задать в Railway → Variables (НЕ заливать в git)

# --- Обязательно ---
BOT_TOKEN=
# Доступ к боту — ТОЛЬКО по Telegram ID: список разрешённых user_id через запятую.
# Пусто = бот закрыт для ВСЕХ (fail-closed), каждая проверка тратит платные лимиты KYT.
# Только цифры, без кавычек и без @username (кавычки ломают разбор — id отбрасываются).
# Свой ID: напишите боту — он вернёт его в отказе, либо спросите у @userinfobot.
ALLOWED_TG_IDS=

# --- Опционально (повышают лимиты, бесплатные) ---
TRONSCAN_API_KEY=
GOPLUS_API_KEY=

# --- Опциональная защита публичного API ---
# Если задано — внешние запросы должны слать ?api_key=...
API_KEY=

# --- Пароль на веб-сайт (HTTP Basic Auth) ---
# Если задан WEB_PASSWORD — сайт (/ и /check) спросит логин/пароль.
# Пусто = сайт открыт. Логин по умолчанию admin, можно сменить через WEB_USER.
WEB_USER=admin
WEB_PASSWORD=

# --- Внешний AML: Swapster (туннель) ---
# Запрашивается ТОЛЬКО для НЕ-биржевых кошельков (биржи/депозитники/контракты
# AML не проверяются). Пусто → в выводе «Swapster не настроен».
SWAPSTER_API_TOKEN=
# Боевой: https://api.swapster.fi · тест: https://test-api.swapster.fi
SWAPSTER_API_BASE_URL=https://api.swapster.fi
# Опц. прокси со статичным IP под whitelist Swapster (http://user:pass@host:port или socks5://host:port)
SWAPSTER_PROXY_URL=
SWAPSTER_PAY_CURRENCY=USDT
SWAPSTER_CHECK_CURRENCY=USDT
SWAPSTER_CHECK_NETWORK=TRC20
SWAPSTER_TIMEOUT_SECONDS=30
# Порог: если у неразмеченного адреса доминирующая биржевая сущность Swapster
# (EXCHANGE*) занимает ≥ этой доли — помечаем адрес как биржу/сервис.
# Ниже порог → ловим больше бирж, но выше риск принять «тяжёлого» юзера биржи
# за саму биржу. 0.9 = 90%.
AML_EXCHANGE_ENTITY_THRESHOLD=0.9

# --- Внешний AML: Bitok KYT (второй сервис, рядом со Swapster) ---
# Ключи создаются в кабинете Bitok (kyt.bitok2.org) → API Keys. Secret показывается
# один раз при создании. Пусто → в выводе «Bitok не настроен».
BITOK_API_KEY_ID=
BITOK_API_SECRET=
# Контур РФ (тот же, что и вход kyt.bitok2.org)
BITOK_API_BASE_URL=https://kyt-api.bitok2.org
BITOK_NETWORK=TRX
# Общий таймаут проверки, он же бюджет поллинга результата
BITOK_TIMEOUT_SECONDS=45

# Внешние AML (Swapster/Bitok) поднимают итоговый вердикт при caution/dangerous.
# 0 — показывать их результат, но вердикт не менять.
EXTERNAL_AML_AFFECTS_RISK=1

# --- Блокировка USDT эмитентом (блэклист Tether) ---
# Самый жёсткий сигнал для USDT-TRC20: заблокированные средства неподвижны.
# Читается прямо у контракта USDT (isBlackListed) через TronGrid, запасной
# путь — /api/security/account/data у TronScan. Ключи не обязательны.
TRONGRID_API_URL=https://api.trongrid.io
# Опционален: free-тариф ~100k запросов/сутки и 15 QPS, без ключа заметно жёстче
TRONGRID_API_KEY=
# 0 — не проверять блэклист вовсе
TETHER_BLACKLIST_CHECK=1

# --- Доступ к вебу и лимиты ---
# Без WEB_PASSWORD и без API_KEY эндпоинт /check отвечает 503: каждая проверка
# тратит платные лимиты KYT, поэтому «открыт всем» — только по явному согласию.
WEB_PUBLIC=0
# Лимиты для открытого доступа (0 = без ограничения)
RATE_LIMIT_PER_IP=20
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_DAILY=500
# CORS: список origin через запятую. Пусто = CORS выключен (веб-форма ходит на
# свой же origin относительным URL и в нём не нуждается).
CORS_ORIGINS=

# --- Объёмная математика AML ---
# В расчёт долей экспозиции идут только эти контракты (USDT/USDC/USDD/TUSD/USDJ
# зашиты). Сверяется КОНТРАКТ, а не символ: символ «USDT» подделывается
# тривиально, и один такой перевод разбавлял санкционную экспозицию до нуля.
# Формат: адрес:символ через запятую.
AML_VOLUME_TOKENS=
# Сколько страниц переводов добирать (по 50 на страницу, TronScan max 50/запрос)
FLOW_PAGES=1

# --- Пороги эвристик (тюнятся на реальных данных, без пересборки образа) ---
# Депозитник биржи: концентрация оттока на одну биржу, доля пересылаемого,
# допустимый обратный поток с этой же биржи (газ, а не торговля).
DEPOSIT_CONCENTRATION=0.9
DEPOSIT_FORWARD_RATIO=0.5
DEPOSIT_BACKFLOW_RATIO=0.15
# Транзит: форвардит ≥ этой доли полученного и не копит баланс
TRANSIT_FORWARD_RATIO=0.8
# Вес косвенной (2-хоп) экспозиции относительно прямой
AML_HOP2_WEIGHT=0.6
# Активность, выше которой нетегированный адрес считаем возможным сервисом
UNTAGGED_SERVICE_TX=50000

# --- Отравление истории (адрес-двойник) ---
# Сколько символов по краям должно совпасть и какая сумма считается пылью
POISON_PREFIX_CHARS=4
POISON_SUFFIX_CHARS=4
POISON_DUST_MAX=1.0

# --- Высокорисковые обменники по тегу TronScan ---
# Обменники без KYC и P2P НЕ должны попадать в EXCHANGE: тот трактуется как
# безопасный и отключает платные KYT. Список пуст намеренно — состав надо
# брать из проверяемого источника. Формат: подстрока_тега:Имя через запятую.
HIGH_RISK_EXCHANGES=

# --- Безопасность контрактов ---
# GET /api/security/token/data у TronScan. 0 — не проверять.
TOKEN_SECURITY_CHECK=1

# --- Журнал проверок и ручные метки (на том же volume /data) ---
# Журнал даёт сравнение с прошлым результатом («было 20, стало 80»), историю
# в боте и вебе и видимый расход платных лимитов KYT.
HISTORY_ENABLED=1
HISTORY_PATH=/data/history.db
HISTORY_RETENTION_DAYS=180
HISTORY_MAX_ROWS=50000
# Метки адресов правятся командами бота (/label, /unlabel) без редеплоя.
# Предзаданные в core/providers/local.py засеваются сюда при старте.
LABELS_PATH=/data/labels.db

# --- Кеш ---
CACHE_TTL_SECONDS=604800
# CACHE_PATH задаётся автоматически на /data/cache.db
